{
    "_comment": "Windsurf IDE MCP Configuration",
    "_location_macos": "~/.codeium/windsurf/mcp_config.json",
    "_location_windows": "%USERPROFILE%\\.codeium\\windsurf\\mcp_config.json",
    "_instructions": "Replace YOUR_RSS_MCP_PATH with your actual RSS-MCP installation path. Access via Windsurf Settings > Cascade > Manage Plugins > View raw config",
    "mcpServers": {
        "rss-news": {
            "command": "node",
            "args": [
                "node_modules/tsx/dist/cli.mjs",
                "src/index.ts"
            ],
            "cwd": "YOUR_RSS_MCP_PATH",
            "env": {
                "MCP_TRANSPORT": "stdio"
            }
        }
    }
}